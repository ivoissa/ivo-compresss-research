<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.ivo</groupId>
  <artifactId>ivo</artifactId>
  <version>0.8.0-research</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <executions>
          <execution><id>jpeg-preferred-pair-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.jpeg.PreferredPairTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>auto-router-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.AutoRouterTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>self-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.SelfTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>deflate-exact-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.deflate.DeflateExactTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>mp3-runtime-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.mp3.SpectralRuntimeTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>nal-length-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.mp4.NalLengthTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>nal-type-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.mp4.NalTypeTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
          <execution><id>slice-header-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.ivo.mp4.SliceHeaderTest</mainClass><classpathScope>test</classpathScope></configuration></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration><release>17</release></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive><manifest><mainClass>io.ivo.cli.IvoCli</mainClass></manifest></archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
